{
  "name": "ts-mcp-weather",
  "version": "1.0.0",
  "description": "A stdio MCP server that shows the weather in an MCP App widget",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:ui && pnpm build:server",
    "build:ui": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview:ui": "vite --open /preview/",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.8.1"
}
